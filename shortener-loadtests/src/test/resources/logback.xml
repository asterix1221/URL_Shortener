<?xml version="1.0" encoding="UTF-8"?>
<!--
  Лог прогона: нужны старт, ход симуляции и ошибки, а не каждый запрос и не внутренности
  Netty с Kafka. Без этого файла Gatling печатает INFO-шум транспорта на всю консоль.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%.20thread] %-40logger{25} : %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.gatling" level="INFO"/>
  <logger name="org.asynchttpclient" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
