{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkStatsResponse",
  "type": "object",
  "required": ["code", "totalClicks", "byDay", "topReferrers"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "totalClicks": {"type": "integer", "minimum": 0},
    "byDay": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "count"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "topReferrers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["referrer", "count"],
        "properties": {
          "referrer": {"type": ["string", "null"]},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
