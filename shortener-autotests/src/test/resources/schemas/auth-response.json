{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthResponse",
  "type": "object",
  "required": ["accessToken", "expiresIn"],
  "properties": {
    "accessToken": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
    "expiresIn": {"type": "integer", "minimum": 1}
  }
}
