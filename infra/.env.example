POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_at_least_32_bytes_long_secret
# Соль для SHA-256 от адреса клиента (click_events.ip_hash). Разные значения на стендах
# означают, что один и тот же IP нельзя соотнести между базами.
IP_SALT=change_me_ip_salt
# Хостовый порт gateway (nginx) — единственный вход снаружи. Порт самого приложения
# в compose не публикуется, поэтому APP_PORT фигурирует и в APP_BASE_URL.
APP_PORT=8080
# 1000, а не дефолтные 10: автотесты этапа 4 создают больше 10 ссылок за минуту,
# и с маленьким лимитом они начали бы падать на 429. Отдельная проверка 429
# поднимает сервис с лимитом 2 (см. RateLimitIT и docs/autotests.md).
RATE_LIMIT_CREATE_PER_MINUTE=1000
# Хостовые порты инфраструктурных контейнеров. По умолчанию совпадают с каноническими,
# но CI-стенд поднимается на своих (28180/5442/6389/29092), чтобы не конфликтовать
# с рабочей копией стека на той же машине.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
# Jenkins (--profile ci). Порт bound к 127.0.0.1, наружу не светится.
JENKINS_PORT=18088
JENKINS_AGENT_PORT=50001
# Пароль администратора Jenkins: задаётся локально, в репозиторий не попадает
# (init.groovy.d создаёт пользователя из этой переменной).
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change_me
# Мониторинг (--profile monitoring). Оба порта bound к 127.0.0.1: ни у Prometheus, ни у
# Grafana нет за спиной ничего, что ограничивало бы доступ, поэтому наружу они не светятся.
# Prometheus скоупит цель http://app:8080/actuator/prometheus внутри сети compose — снаружи
# gateway закрывает этот путь (403), так что отдельной переменной порт цели не задаётся.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Пароль администратора Grafana: задаётся локально, в репозиторий не попадает.
GRAFANA_PASSWORD=change_me
# Переключатели экспериментов этапа 7 (docs/experiments/). Значения ниже — поведение сервиса
# по умолчанию; прогон варианта меняется переменными shell, которые перекрывают этот файл:
#   $env:APP_CACHE_ENABLED='false'; .\scripts\reset-state.ps1
APP_CACHE_ENABLED=true
# async — клик публикуется в Kafka и пишется фоном; sync — пишется в потоке редиректа.
APP_CLICKS_MODE=async
# Дефолт Hikari. Больше 100 не ставить: это потолок max_connections у postgres:16.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# Пусто по умолчанию. Для soak-прогона сюда добавляют -XX:StartFlightRecording=…
JAVA_TOOL_OPTIONS=
